# Доступ к хранилищу Copernicus Data Space (S3-совместимое, eodata).
# Скопируйте в `.env` рядом — он в .gitignore и в репозиторий не попадает.
#
# Ключи выпускаются в личном кабинете CDSE, раздел S3 credentials:
# https://dataspace.copernicus.eu/ → Profile → S3 Credentials
#
# Без них приложение соберётся и запустится, но data-provider не сможет ни
# обойти каталог, ни подписать адрес: экраны Browse и Preview останутся пустыми,
# а скачивание не начнётся.

COPERNICUS_ACCESS_KEY=
COPERNICUS_ACCESS_SECRET=
