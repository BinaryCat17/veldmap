# Access to Copernicus Data Space storage (S3-compatible, eodata).
# Copy it to `.env` next to this file — that one is in .gitignore and never
# reaches the repository.
#
# Keys are issued in the CDSE personal account, section S3 credentials:
# https://dataspace.copernicus.eu/ → Profile → S3 Credentials
#
# Without them the application builds and runs, but data-provider can neither
# walk the catalogue nor sign an address: catalogue and viewing say that there
# are no keys, and downloading never starts. Imagery search works without the
# keys as well — CDSE serves metadata to everyone.

COPERNICUS_ACCESS_KEY=
COPERNICUS_ACCESS_SECRET=
