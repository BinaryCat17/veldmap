fn main() -> Result<(), Box<dyn std::error::Error>> {
    let mut config = prost_build::Config::new();
    config.type_attribute(".", "#[derive(serde::Serialize, serde::Deserialize)]");
    
    // Типы указаны явно: у модуля без собственного types.proto оба вектора
    // остаются пустыми, и выводить их элемент компилятору не из чего.
    let {% if local_proto_path %}mut {% endif %}proto_files: Vec<String> = Vec::new();
    let {% if include_dirs %}mut {% endif %}include_dirs: Vec<String> = Vec::new();

{% if local_proto_path %}
    proto_files.push("{{ local_proto_path }}".to_string());
{% endif %}

{% for include_dir in include_dirs %}
    include_dirs.push("{{ include_dir }}".to_string());
{% endfor %}

    for proto in &proto_files {
        println!("cargo:rerun-if-changed={}", proto);
    }

    if !proto_files.is_empty() {
        config.compile_protos(&proto_files, &include_dirs)?;
    }
    
    Ok(())
}
