/// ответом он кончается.
///
/// Событие в полёте — это и есть задача, поэтому «завести» и «закрыть» у
/// платформы не топики, а следствие самой публикации: диспетчер открывает
/// учёт на отменяемом запросе и закрывает на его терминальном ответе. Обе
/// половины таблицы отсортированы — поиск бинарный, аллокаций нет.
pub mod flow {
    /// Отменяемые запросы (`cancellable: true`) и терминальные ответы, в
    /// которые они кончаются. Пара нужна целиком: на запросе диспетчер заводит
    /// учёт, а ответом из той же строки отвечает за убитого исполнителя —
    /// заказчик получает свой единственный терминальный ответ независимо от
    /// того, как операция кончилась.
    pub const CANCELLABLE: &[(&str, &str)] = &[
        {%- for e in cancellable %}
        ("{{ e.request }}", "{{ e.terminal }}"),
        {%- endfor %}
    ];

    /// Терминальные ответы этих запросов: на них учёт снимается. Ответ,
    /// объявленный промежуточным (прогресс), сюда не попадает и операцию
    /// не закрывает.
    pub const TERMINAL: &[&str] = &[
        {%- for topic in terminal %}
        "{{ topic }}",
        {%- endfor %}
    ];

    /// Терминальный ответ отменяемого запроса — `None`, если топик отменяемым
    /// не объявлен и учёт на него не заводится.
    pub fn terminal_reply_of(topic: &str) -> Option<&'static str> {
        CANCELLABLE.binary_search_by_key(&topic, |(request, _)| request)
            .ok()
            .map(|at| CANCELLABLE[at].1)
    }

    /// Закрывает ли публикация этого топика учёт операции.
    pub fn is_terminal(topic: &str) -> bool {
        TERMINAL.binary_search(&topic).is_ok()
    }
}
