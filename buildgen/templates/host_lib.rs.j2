}

/// Поток операции, выведенный из схем: чем кончается каждый запрос и какой из
/// них можно убить.
///
/// Событие в полёте — это и есть задача, поэтому «завести» и «закрыть» у
/// платформы не топики, а следствие самой публикации: диспетчер открывает учёт
/// на запросе и закрывает на его терминальном ответе. Таблица отсортирована по
/// запросу — поиск бинарный, аллокаций нет.
pub mod flow {
    /// Обмен: запрос, ответ, которым он обязан кончиться, и можно ли его убить.
    pub struct Exchange {
        pub terminal: &'static str,
        /// Объявлен ли запрос отменяемым (`cancellable: true`). Учёт заводится
        /// не ради одной отмены: убить можно только объявленное, а договорить
        /// конец за упавшего исполнителя надо у всякого обмена.
        pub cancellable: bool,
    }

    /// Все запросы с объявленным терминальным ответом. Пара нужна целиком: на
    /// запросе диспетчер заводит учёт, а ответом из той же строки отвечает за
    /// исполнителя, которого не стало, — заказчик получает свой единственный
    /// терминальный ответ независимо от того, как операция кончилась.
    ///
    /// Промежуточного ответа (прогресса) здесь нет вовсе: он приходит
    /// многократно и операцию не закрывает.
    pub const FLOW: &[(&str, &str, bool)] = &[
        {%- for e in flow %}
        ("{{ e.request }}", "{{ e.terminal }}", {{ "true" if e.cancellable else "false" }}),
        {%- endfor %}
    ];

    /// Чем кончается этот запрос — `None`, если топик запросом не является:
    /// у него нет ответа, и учёту не на чем держаться.
    pub fn exchange_of(topic: &str) -> Option<Exchange> {
        FLOW.binary_search_by_key(&topic, |(request, ..)| request)
            .ok()
            .map(|at| Exchange { terminal: FLOW[at].1, cancellable: FLOW[at].2 })
    }
}
