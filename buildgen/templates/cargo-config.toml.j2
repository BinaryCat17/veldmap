[build]
# simd128 не включаем, и это замер, а не осторожность: на проходе по тайловому
# TIFF он стои́т 11 % времени (0,51 с против 0,46 на шестнадцати тайлах, три
# прогона в ноль). Векторных путей у этого декодера нет, а глобальная
# автовекторизация здесь только портит код. Мерить его снова стои́т на гранулах
# JPEG 2000 — у их крейта векторные пути есть, но в корпусе их нет ни одной.
rustflags = ["-Zthreads=16"]
