[package]
name = "{{ api_crate_name }}"
version = "{{ version }}"
edition = "2021"

[dependencies]
prost = "0.14"
serde = { version = "1.0", features = ["derive"] }
serde_json = "1.0"
futures-util = { version = "0.3", default-features = false }
{% if wrap_sdk_path %}
veldsdk = { path = "{{ wrap_sdk_path }}"{% if sdk_features %}, features = [{% for f in sdk_features %}"{{ f }}"{% if not loop.last %}, {% endif %}{% endfor %}]{% endif %} }
{% endif %}

[build-dependencies]
prost-build = "0.14"
