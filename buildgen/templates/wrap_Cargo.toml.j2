# Standalone package — keeps `cargo check` on the wrap independent of the
# module workspace it is nested in.
[workspace]

[package]
name = "{{ api_crate_name }}"
version = "{{ version }}"
edition = "2024"

[dependencies]
prost = "0.14"
serde = { version = "1.0", features = ["derive"] }
serde_json = "1.0"
{% if wrap_sdk_path %}
veldsdk = { path = "{{ wrap_sdk_path }}" }
{% endif %}
{% for name, version in wrap_dependencies.items() %}
{{ name }} = {{ version }}
{% endfor %}

[build-dependencies]
prost-build = "0.14"
