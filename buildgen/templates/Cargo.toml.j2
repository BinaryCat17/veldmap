# Standalone workspace — prevents cargo from inheriting a parent workspace
[workspace]

[package]
name = "{{ module_name }}"
version = "{{ version }}"
edition = "2024"

[lib]
crate-type = ["cdylib"]
path = "src/lib.rs"

[dependencies]
veldsdk = { path = "{{ sdk_path }}" }
{% for name, version in dependencies.items() %}
{{ name }} = {{ version }}
{% endfor %}

[build-dependencies]
prost-build = "0.14"

[profile.release]
# По скорости, а не по размеру: в модулях лежит попиксельная работа — декодеры,
# ужатие, растяг, — и размер бинарника не стои́т ничего, он не едет по проводу.
opt-level = 3
panic = "abort"
lto = false
codegen-units = 16
