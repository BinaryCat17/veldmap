# Standalone workspace — prevents cargo from inheriting a parent workspace
[workspace]

[package]
name = "{{ module_name }}"
version = "{{ version }}"
edition = "2021"

[lib]
crate-type = ["cdylib"]
path = "src/lib.rs"

[dependencies]
veldsdk = { path = "{{ sdk_path }}"{% if sdk_features %}, features = [{% for feat in sdk_features %}"{{ feat }}"{% if not loop.last %}, {% endif %}{% endfor %}]{% endif %} }
{% for name, version in dependencies.items() %}
{{ name }} = {{ version }}
{% endfor %}

[build-dependencies]
prost-build = "0.14"

[profile.release]
opt-level = "s"
panic = "abort"
lto = true
codegen-units = 1
